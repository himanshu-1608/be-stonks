# be-stonks environment configuration.
# Copy this file to .env and fill in real values. .env is gitignored.
# On EC2, place .env at the working directory (or let systemd load it via EnvironmentFile).
# Real environment variables always take precedence over values in .env.

# Kite Connect app credentials (from https://kite.trade > My apps).
KITE_API_KEY=your_api_key_here
KITE_API_SECRET=your_api_secret_here

# Active alerts provider (default: kite).
ALERT_PROVIDER=kite

# HTTP server port (default: 8000).
# Must match the port in your Kite app redirect URL, e.g. http://127.0.0.1:8000/auth/callback
PORT=8000

# Data and run-report directories (defaults: data, runs).
DATA_DIR=data
RUNS_DIR=runs

# Throttle between alert creations, in milliseconds (default: 250).
CREATE_DELAY_MS=250
